#!/usr/bin/env bash
# The dataset suite's one command: `dataset <group> <verb> [args...]` runs dataset-<group>-<verb>
# from this directory with the remaining arguments, and with no arguments lists the commands, each
# with the summary from its `# dataset:summary=` line. It resolves its own path, so it runs from
# any working directory; a new command is a new dataset-<group>-<verb> file here, with nothing to
# register. An unknown command or a usage error goes to stderr and exits 2.
set -euo pipefail

dir=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
# shellcheck source=lib/dataset.sh
source "$dir/../lib/dataset.sh"

usage='<group> <verb> [args...]'

if (($# == 0)); then
  echo "usage: dataset $usage"
  for script in "$dir"/dataset-*-*; do
    [[ -x $script ]] || continue
    name=${script##*/dataset-}
    summary=$(sed -n 's/^# dataset:summary=//p' "$script")
    printf '  dataset %-22s %s\n' "${name%%-*} ${name#*-}" "$summary"
  done
  exit 0
fi

if (($# == 1)); then
  dataset_usage_error "'$1' names no verb; run dataset with no arguments to list the commands" \
    "$usage"
fi

target="$dir/dataset-$1-$2"
if [[ ! $1 =~ ^[a-z]+$ || ! $2 =~ ^[a-z]+$ || ! -x $target ]]; then
  dataset_usage_error "no command '$1 $2'; run dataset with no arguments to list the commands"
fi
shift 2
exec "$target" "$@"
